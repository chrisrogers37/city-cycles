# AWS Credentials (required)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# S3 Configuration (required)
S3_BUCKET=city-cycles-data-ctr37

# DuckDB Configuration (optional - defaults set in Dockerfile)
# DUCKDB_MEMORY_LIMIT=2GB
# DUCKDB_THREADS=2

# Extraction Configuration (optional)
# NYC_START_YEAR=2019
# ENABLE_NYC_EXTRACTION=true
# ENABLE_LONDON_EXTRACTION=true

# Pipeline Configuration (optional)
# LOG_LEVEL=INFO
# CONTINUE_ON_STAGE_FAILURE=false
